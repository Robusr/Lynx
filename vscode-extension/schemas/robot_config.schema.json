{
  "$defs": {
    "DataConfig": {
      "properties": {
        "frames_dir": {
          "default": "data/frames",
          "title": "Frames Dir",
          "type": "string"
        },
        "index_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Path"
        }
      },
      "title": "DataConfig",
      "type": "object"
    },
    "DomainControllerConfig": {
      "properties": {
        "model": {
          "default": "laptop",
          "title": "Model",
          "type": "string"
        },
        "inference_backend": {
          "default": "onnx_cpu",
          "title": "Inference Backend",
          "type": "string"
        }
      },
      "title": "DomainControllerConfig",
      "type": "object"
    },
    "OutputConfig": {
      "properties": {
        "frame_id": {
          "default": "base_link",
          "title": "Frame Id",
          "type": "string"
        },
        "rate_hz": {
          "default": 10.0,
          "title": "Rate Hz",
          "type": "number"
        }
      },
      "title": "OutputConfig",
      "type": "object"
    },
    "PerceptionConfig": {
      "properties": {
        "backend": {
          "default": "offline",
          "title": "Backend",
          "type": "string"
        },
        "conf": {
          "default": 0.4,
          "title": "Conf",
          "type": "number"
        },
        "modules": {
          "items": {
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        },
        "roi": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Roi",
          "type": "object"
        },
        "small_target_enhance": {
          "default": false,
          "title": "Small Target Enhance",
          "type": "boolean"
        }
      },
      "title": "PerceptionConfig",
      "type": "object"
    },
    "SafetyConfig": {
      "properties": {
        "min_obstacle_height_m": {
          "default": 0.05,
          "title": "Min Obstacle Height M",
          "type": "number"
        },
        "max_detection_latency_ms": {
          "default": 100.0,
          "title": "Max Detection Latency Ms",
          "type": "number"
        }
      },
      "title": "SafetyConfig",
      "type": "object"
    },
    "SensorConfig": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "topic": {
          "default": "",
          "title": "Topic",
          "type": "string"
        },
        "mount": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Mount",
          "type": "object"
        },
        "fps": {
          "default": 20.0,
          "title": "Fps",
          "type": "number"
        },
        "sync_source": {
          "default": "software",
          "title": "Sync Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "SensorConfig",
      "type": "object"
    },
    "VehicleConfig": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "ackermann",
          "title": "Type",
          "type": "string"
        },
        "max_speed_ms": {
          "default": 5.0,
          "title": "Max Speed Ms",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "VehicleConfig",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "vehicle": {
      "$ref": "#/$defs/VehicleConfig"
    },
    "domain_controller": {
      "$ref": "#/$defs/DomainControllerConfig"
    },
    "sensors": {
      "items": {
        "$ref": "#/$defs/SensorConfig"
      },
      "title": "Sensors",
      "type": "array"
    },
    "perception": {
      "$ref": "#/$defs/PerceptionConfig"
    },
    "output": {
      "$ref": "#/$defs/OutputConfig"
    },
    "safety": {
      "$ref": "#/$defs/SafetyConfig"
    },
    "data": {
      "$ref": "#/$defs/DataConfig"
    }
  },
  "required": [
    "vehicle"
  ],
  "title": "RobotConfig",
  "type": "object"
}