{
  "Lynx robot config": {
    "scope": "yaml",
    "prefix": "lynx",
    "description": "Lynx perception SDK — robot config scaffold",
    "body": [
      "schema_version: \"1.0\"",
      "",
      "vehicle:",
      "  name: \"${1:demo_factory_truck}\"",
      "  type: \"ackermann\"",
      "  max_speed_ms: 5.0",
      "",
      "domain_controller:",
      "  model: \"${2|laptop,jetson_orin_nano,rk3588|}\"",
      "  inference_backend: \"${3|onnx_cpu,onnx_cuda,tensorrt,onnx_acl,onnx_coreml|}\"",
      "",
      "sensors:",
      "  - name: \"front_cam\"",
      "    type: \"${4|camera,lidar,radar,imu,gnss|}\"",
      "    model: \"demo_replay_cam\"",
      "    topic: \"cam/front\"",
      "    mount: { x: 0.0, y: 0.0, z: 1.4, roll: 0, pitch: 0, yaw: 0 }",
      "    fps: 20",
      "    sync_source: \"${5|pps,gptp,ntp,software|}\"",
      "",
      "perception:",
      "  backend: \"${6|offline,enhanced,onnx|}\"",
      "  conf: 0.4",
      "  modules: [detection, tracking, traffic_sign]",
      "  roi: { forward_m: 60, lateral_m: 15 }",
      "  small_target_enhance: false",
      "",
      "output:",
      "  frame_id: \"base_link\"",
      "  rate_hz: 10",
      "",
      "safety:",
      "  min_obstacle_height_m: 0.05",
      "  max_detection_latency_ms: 100",
      "",
      "data:",
      "  frames_dir: \"data/frames\"",
      "  index_path: \"data/index.csv\""
    ]
  }
}
