{
  "$defs": {
    "BBox2D": {
      "description": "Axis-aligned 2D box in image pixels (top-left origin).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BBox2D",
      "type": "object"
    },
    "BBox3D": {
      "description": "3D box in the vehicle frame (right-handed: forward-x, left-y, up-z).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "l": {
          "title": "L",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        },
        "h": {
          "title": "H",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "l",
        "w",
        "h",
        "yaw"
      ],
      "title": "BBox3D",
      "type": "object"
    },
    "ObjectType": {
      "description": "Coarse object taxonomy, ASAM OpenLABEL-aligned (the doc's `Object.type`).",
      "enum": [
        "pedestrian",
        "bicycle",
        "vehicle",
        "truck",
        "cone",
        "barrier",
        "traffic_sign",
        "traffic_light",
        "unknown"
      ],
      "title": "ObjectType",
      "type": "string"
    },
    "SignType": {
      "description": "Traffic sign / signal taxonomy (the doc's `TrafficSign.type`).",
      "enum": [
        "stop",
        "speed_limit",
        "yield",
        "no_entry",
        "traffic_light",
        "unknown"
      ],
      "title": "SignType",
      "type": "string"
    },
    "SourceMask": {
      "description": "Sensor provenance bitmask — a fused object carries several bits at once.",
      "enum": [
        1,
        2,
        4
      ],
      "title": "SourceMask",
      "type": "integer"
    },
    "Track": {
      "description": "A tracked detection with a persistent id and velocity.",
      "properties": {
        "cls_id": {
          "title": "Cls Id",
          "type": "integer"
        },
        "cls_name": {
          "title": "Cls Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ObjectType",
          "default": "unknown"
        },
        "sub_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Type"
        },
        "bbox_2d": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox2D"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bbox_3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox3D"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/SourceMask",
          "default": 1,
          "description": "SourceMask bitmask: 1=camera, 2=lidar, 4=radar (OR together for fusion)."
        },
        "occlusion_ratio": {
          "default": 0.0,
          "title": "Occlusion Ratio",
          "type": "number"
        },
        "small_target_score": {
          "default": 0.0,
          "title": "Small Target Score",
          "type": "number"
        },
        "pose_covariance": {
          "description": "6x6 pose covariance, row-major; empty when unknown.",
          "items": {
            "type": "number"
          },
          "title": "Pose Covariance",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": true,
          "description": "@ai-extend custom attributes (free-form).",
          "title": "Attributes",
          "type": "object"
        },
        "track_id": {
          "title": "Track Id",
          "type": "integer"
        },
        "velocity": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Velocity",
          "type": "array"
        }
      },
      "required": [
        "cls_id",
        "cls_name",
        "confidence",
        "track_id"
      ],
      "title": "Track",
      "type": "object"
    },
    "TrafficSign": {
      "description": "A detected traffic sign / light.",
      "properties": {
        "id": {
          "default": 0,
          "title": "Id",
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/SignType",
          "default": "unknown"
        },
        "cls_name": {
          "title": "Cls Name",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "bbox_2d": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox2D"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bbox_3d": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox3D"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "stamp_ns": {
          "default": 0,
          "title": "Stamp Ns",
          "type": "integer"
        }
      },
      "required": [
        "cls_name",
        "confidence"
      ],
      "title": "TrafficSign",
      "type": "object"
    }
  },
  "description": "The standardized output frame published once per detection cycle.\n\n`stamp_ns` + `frame_id` + `seq` map to the architecture doc's `Header`\nmessage (flattened here for the Python prototype).",
  "properties": {
    "stamp_ns": {
      "title": "Stamp Ns",
      "type": "integer"
    },
    "frame_id": {
      "title": "Frame Id",
      "type": "string"
    },
    "seq": {
      "default": 0,
      "title": "Seq",
      "type": "integer"
    },
    "backend": {
      "default": "offline",
      "title": "Backend",
      "type": "string"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/Track"
      },
      "title": "Objects",
      "type": "array"
    },
    "traffic_signs": {
      "items": {
        "$ref": "#/$defs/TrafficSign"
      },
      "title": "Traffic Signs",
      "type": "array"
    },
    "latency_ms": {
      "default": 0.0,
      "title": "Latency Ms",
      "type": "number"
    }
  },
  "required": [
    "stamp_ns",
    "frame_id"
  ],
  "title": "PerceptionFrame",
  "type": "object"
}