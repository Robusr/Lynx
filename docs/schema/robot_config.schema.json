{
  "$defs": {
    "CalibrationConfig": {
      "additionalProperties": false,
      "description": "Calibration artifacts (intrinsics/extrinsics/time-offset) for CalibStore.\n\nPaths are contract fields; the CalibStore loader (and ISensorAdapter.init's\n`calib` argument) is a later milestone, so these are declared but not yet read.",
      "properties": {
        "camera_intrinsics": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-camera intrinsic calibration file.",
          "title": "Camera Intrinsics"
        },
        "extrinsics": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sensor extrinsics file (merged with mount).",
          "title": "Extrinsics"
        },
        "lidar_camera_extrinsic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lidar↔camera extrinsic file.",
          "title": "Lidar Camera Extrinsic"
        },
        "time_offset_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Per-sensor time offset in ms (sync compensation).",
          "title": "Time Offset Ms",
          "type": "object"
        }
      },
      "title": "CalibrationConfig",
      "type": "object"
    },
    "DataConfig": {
      "additionalProperties": false,
      "properties": {
        "frames_dir": {
          "default": "data/frames",
          "description": "Directory of replay frames (demo/CI source).",
          "title": "Frames Dir",
          "type": "string"
        },
        "index_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frame index CSV; optional.",
          "title": "Index Path"
        }
      },
      "title": "DataConfig",
      "type": "object"
    },
    "DomainControllerConfig": {
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "default": "nvidia",
          "description": "Chip vendor (drives resource/consistency checks).",
          "enum": [
            "nvidia",
            "horizon",
            "ti",
            "qualcomm",
            "blacksesame",
            "rockchip"
          ],
          "title": "Vendor",
          "type": "string"
        },
        "model": {
          "default": "laptop",
          "description": "Onboard compute target (drives resource-budget checks).",
          "enum": [
            "laptop",
            "jetson_orin_nano",
            "rk3588"
          ],
          "title": "Model",
          "type": "string"
        },
        "compute_tops": {
          "default": 0.0,
          "description": "INT8 TOPS, advisory for the resource budget (0 = unspecified).",
          "title": "Compute Tops",
          "type": "number"
        },
        "inference_backend": {
          "default": "onnx_cpu",
          "description": "Inference execution provider for the ONNX backend.",
          "enum": [
            "onnx_cpu",
            "onnx_cuda",
            "tensorrt",
            "onnx_acl",
            "onnx_coreml"
          ],
          "title": "Inference Backend",
          "type": "string"
        },
        "os": {
          "default": "ubuntu_22.04",
          "description": "Controller OS image.",
          "title": "Os",
          "type": "string"
        },
        "middleware": {
          "default": "custom",
          "description": "Middleware transport (feeds IMiddlewareAdapter).",
          "enum": [
            "ros2_humble",
            "ros2_iron",
            "dds_rti",
            "some_ip",
            "custom"
          ],
          "title": "Middleware",
          "type": "string"
        }
      },
      "title": "DomainControllerConfig",
      "type": "object"
    },
    "OutputConfig": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "default": "base_link",
          "description": "Coordinate frame for published objects.",
          "title": "Frame Id",
          "type": "string"
        },
        "rate_hz": {
          "default": 10.0,
          "description": "Perception loop rate (Hz).",
          "title": "Rate Hz",
          "type": "number"
        }
      },
      "title": "OutputConfig",
      "type": "object"
    },
    "PerceptionConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "offline",
          "description": "Detection backend: offline (YOLO11s) | enhanced (YOLO11x + ROI) | onnx (ONNX Runtime).",
          "enum": [
            "offline",
            "enhanced",
            "onnx"
          ],
          "title": "Backend",
          "type": "string"
        },
        "conf": {
          "default": 0.4,
          "description": "Detection confidence threshold (full-frame pass).",
          "title": "Conf",
          "type": "number"
        },
        "modules": {
          "description": "Enabled pipeline modules.",
          "items": {
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        },
        "roi": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Region of interest around the ego vehicle (meters).",
          "title": "Roi",
          "type": "object"
        },
        "small_target_enhance": {
          "default": true,
          "description": "Small-target ROI re-inference pass (enhanced backend only; ignored by offline/onnx).",
          "title": "Small Target Enhance",
          "type": "boolean"
        }
      },
      "title": "PerceptionConfig",
      "type": "object"
    },
    "SafetyConfig": {
      "additionalProperties": false,
      "properties": {
        "min_braking_distance_m": {
          "default": 1.0,
          "description": "Minimum braking distance (m); must be > 0.",
          "title": "Min Braking Distance M",
          "type": "number"
        },
        "min_obstacle_height_m": {
          "default": 0.05,
          "description": "Minimum obstacle height to consider (m).",
          "title": "Min Obstacle Height M",
          "type": "number"
        },
        "max_detection_latency_ms": {
          "default": 100.0,
          "description": "Latency ceiling (ms); violations flagged.",
          "title": "Max Detection Latency Ms",
          "type": "number"
        },
        "redundant_fov_required": {
          "default": true,
          "description": "Require redundant forward FOV coverage.",
          "title": "Redundant Fov Required",
          "type": "boolean"
        }
      },
      "title": "SafetyConfig",
      "type": "object"
    },
    "SensorConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Sensor name (must be unique).",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "Sensor modality.",
          "enum": [
            "camera",
            "lidar",
            "radar",
            "imu",
            "gnss"
          ],
          "title": "Type",
          "type": "string"
        },
        "model": {
          "default": "",
          "description": "Sensor model / driver identifier.",
          "title": "Model",
          "type": "string"
        },
        "interface": {
          "default": "ethernet",
          "description": "Physical interface (drives the interface-contract check).",
          "enum": [
            "gige",
            "ethernet",
            "can",
            "usb"
          ],
          "title": "Interface",
          "type": "string"
        },
        "topic": {
          "default": "",
          "description": "Data topic (middleware-dependent).",
          "title": "Topic",
          "type": "string"
        },
        "mount": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Extrinsics relative to the vehicle frame (x/y/z in m, roll/pitch/yaw in rad).",
          "title": "Mount",
          "type": "object"
        },
        "fps": {
          "default": 20.0,
          "description": "Native sensor rate (Hz).",
          "title": "Fps",
          "type": "number"
        },
        "sync_source": {
          "default": "software",
          "description": "Time-sync source; a single master clock is required.",
          "enum": [
            "pps",
            "gptp",
            "ntp",
            "software"
          ],
          "title": "Sync Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "SensorConfig",
      "type": "object"
    },
    "VehicleConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Vehicle identifier, e.g. 'demo_factory_truck'.",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "ackermann",
          "description": "Kinematic model.",
          "enum": [
            "diff_drive",
            "ackermann",
            "skid_steer",
            "omni"
          ],
          "title": "Type",
          "type": "string"
        },
        "max_speed_ms": {
          "default": 5.0,
          "description": "Speed ceiling in m/s; safety checks reject <= 0.",
          "title": "Max Speed Ms",
          "type": "number"
        },
        "wheelbase_m": {
          "default": 1.8,
          "description": "Wheelbase in m (kinematic/geometry; no runtime consumer yet).",
          "title": "Wheelbase M",
          "type": "number"
        },
        "track_width_m": {
          "default": 1.4,
          "description": "Track width in m (geometry; no runtime consumer yet).",
          "title": "Track Width M",
          "type": "number"
        },
        "dimensions": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Vehicle envelope l/w/h in m (geometry; no runtime consumer yet).",
          "title": "Dimensions",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "VehicleConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Manifest schema version.",
      "title": "Schema Version",
      "type": "string"
    },
    "vehicle": {
      "$ref": "#/$defs/VehicleConfig",
      "description": "Vehicle description."
    },
    "domain_controller": {
      "$ref": "#/$defs/DomainControllerConfig",
      "description": "Onboard compute."
    },
    "sensors": {
      "description": "Sensor suite (camera/lidar/...).",
      "items": {
        "$ref": "#/$defs/SensorConfig"
      },
      "title": "Sensors",
      "type": "array"
    },
    "perception": {
      "$ref": "#/$defs/PerceptionConfig",
      "description": "Perception configuration."
    },
    "output": {
      "$ref": "#/$defs/OutputConfig",
      "description": "Output / publish configuration."
    },
    "calibration": {
      "$ref": "#/$defs/CalibrationConfig",
      "description": "Calibration artifacts."
    },
    "safety": {
      "$ref": "#/$defs/SafetyConfig",
      "description": "Safety bounds."
    },
    "data": {
      "$ref": "#/$defs/DataConfig",
      "description": "Replay data source."
    }
  },
  "required": [
    "vehicle"
  ],
  "title": "RobotConfig",
  "type": "object"
}